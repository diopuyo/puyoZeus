# SHA固定のPython・シェルコードをWindowsでもLFのまま取得する。
*.py text eol=lf
*.sh text eol=lf
tests/g3_isolated_files.txt text eol=lf
# 配布既定の比較元は24w2原JSONのSHAを改行も含めて検証する。
tests/fixtures/release_obs_24w2.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# 撃ち返し補正は PC2 納品 JSON の SHA を改行も含めて保つ。
src/counter_fire_shift_1b.json -text
# 凍結検証資産は記録されたblobのバイト列をそのまま保持する。
data/verify/** -text
.runtime_snapshots/** -text
docs/agent_coordination/G3_VIDEO_VALIDATION_PREREG_2026-09-07.json -text
docs/manifests/*.tsv -text
docs/agent_coordination/NEXT_ENQUEUE_LIVE_WIRING_PLAN_2026-09-08.md -text
docs/agent_coordination/NEXT_LIVE_RUN_PLAN_2026-09-08.md -text
